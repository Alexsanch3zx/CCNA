@startuml CCNA_ACL_Port_Security_Topology
' CCNA Mini Lab — ACL + Port Security
' Render: plantuml labs/ACL_Port_Security/CCNA_ACL_Port_Security_Topology.puml
' Or: https://www.plantuml.com/plantuml
!theme plain
top to bottom direction
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam ArrowColor #37474F
skinparam ArrowThickness 1.5
skinparam nodesep 40
skinparam ranksep 45

title **CCNA Mini Lab — ACL & Port Security**\nSwitch MAC lock + Router IP filter

legend top
  |= Color |= VLAN | Network | Gateway |
  | <#BBDEFB> | 10 STAFF | 192.168.10.0/24 | 192.168.10.1 |
  | <#FFF9C4> | 20 GUEST | 192.168.20.0/24 | 192.168.20.1 |
  | <#C8E6C9> | 30 SERVERS | 192.168.30.0/24 | 192.168.30.1 |
  ----
  **Port security** on Fa0/1 (sticky, max 1)
  **ACL 101** on R1 g0/0.20 in — deny Guest → Servers
endlegend

package "R1 (2911) — Inter-VLAN + ACL" #FFCCBC {
  object "Gig0/0\n(physical)\nno IP | no shutdown" as R1_PHY #FFFFFF
  together {
    object "Gig0/0.10\ndot1Q 10\n192.168.10.1/24" as R1_10 #BBDEFB
    object "Gig0/0.20\ndot1Q 20\n192.168.20.1/24\nACL 101 in" as R1_20 #FFF9C4
    object "Gig0/0.30\ndot1Q 30\n192.168.30.1/24" as R1_30 #C8E6C9
  }
  R1_PHY -[hidden]down- R1_10
}

package "SW1 (2960)" #CFD8DC {
  object "Fa0/24 TRUNK" as SW1_24 #A5D6A7
  object "Fa0/1 Access VLAN10\nPort Security\nmax 1 sticky" as SW1_1 #BBDEFB
  object "Fa0/2 Access VLAN20" as SW1_2 #FFF9C4
  object "Fa0/3 Access VLAN30" as SW1_3 #C8E6C9
}

together {
  object "PC0 Staff\n192.168.10.10" as PC0 #BBDEFB
  object "PC1 Guest\n192.168.20.10" as PC1 #FFF9C4
  object "Server0\n192.168.30.10" as SRV #C8E6C9
}

R1_PHY --> SW1_24 : **Trunk**\nGig0/0 ↔ Fa0/24
SW1_1 --> PC0 : Fa0/1 ↔ Fa0
SW1_2 --> PC1 : Fa0/2 ↔ Fa0
SW1_3 --> SRV : Fa0/3 ↔ Fa0

note right of R1_20
  **ACL 101**
  ----
  deny Guest → Servers
  permit ip any any
end note

note bottom of SW1_1
  Wrong MAC →
  **err-disabled**
end note

@enduml
